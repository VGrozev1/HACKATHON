{
  "mcpServers": {
    "supabase": {
      "url": "https://mcp.supabase.com/mcp?project_ref=wswjqtipgwtjdsnxqvcu"
    },
    "github": {
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "vercel": {
      "url": "https://mcp.vercel.com"
    },
    "context7": {
      "url": "https://mcp.context7.com/mcp"
    },
    "shadcn": {
      "command": "npx",
      "args": [
        "shadcn@latest",
        "mcp"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ]
    },
    "next-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "next-devtools-mcp@latest"
      ]
    },
    "prisma": {
      "command": "npx",
      "args": [
        "prisma",
        "mcp"
      ]
    }
  }
}
