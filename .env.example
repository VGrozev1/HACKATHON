# Copy to .env and fill in. Never commit .env; share the real values with the team
# privately (password manager or a DM), never in Git or an AI chat.

# ── Database (Supabase → Project Settings → Database → Connection string) ──
# Pooled connection (port 6543, "Transaction pooler"), used by the app at runtime:
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432), used by Prisma migrations:
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ── Claude API (console.anthropic.com → API keys) — Viktor, B1 ──
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"

# ── Telegram bot (talk to @BotFather → /newbot) — Viktor, B6 ──
TELEGRAM_BOT_TOKEN=""
# Any long random string; Telegram sends it back on every webhook call.
TELEGRAM_WEBHOOK_SECRET=""
# The stocker's chat id (message the bot, then open https://api.telegram.org/bot<TOKEN>/getUpdates)
TELEGRAM_STOCKER_CHAT_ID=""
# Who gets "approve order over €300" requests
TELEGRAM_APPROVER_CHAT_ID=""

# ── Resend (resend.com → API keys) — Viktor, B7 ──
RESEND_API_KEY=""
# Until a domain is verified in Resend, send from onboarding@resend.dev
RESEND_FROM="Vending Agent <onboarding@resend.dev>"
# Team Gmail inbox where supplier emails land during the demo
SUPPLIER_DEMO_EMAIL=""

# ── App ──
# Public URL (Vercel) — used to register the Telegram webhook
APP_URL="http://localhost:3000"
# Orders above this wait for approval (guardrail B5)
AUTO_APPROVE_LIMIT_EUR="300"

# ── Frontend data source (Kalin, src/lib/api.ts) ──
# Leave unset to use the real API (falls back to built-in demo data if it fails). "true" forces the mocks.
NEXT_PUBLIC_USE_MOCK=""
# Where the API lives; empty means this app's own /api routes.
NEXT_PUBLIC_API_BASE_URL=""
# Once Viktor's agent run endpoints (B1) are live: "true" makes Run night use the real agent.
NEXT_PUBLIC_AGENT_LIVE=""

# ── Investor portal login (Kalin) ──
# Signs the investor session cookie. Any long random string, e.g. `openssl rand -base64 32`.
# Required in production; local development falls back to a built-in development secret.
AUTH_SECRET=""
